{
  "expo": {
    "name": "Hardware Centers",
    "slug": "hardware-centre-app",
    "scheme": "hardwarecentre",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#1F2937",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.hardwarecentre.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.hardwarecentre.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#1F2937",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c21924c0-681e-459b-b6df-e86b4682cbe2"
      }
    },
    "owner": "dmdevdutt6",
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#1F2937"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Hardware Centers uses your location to show delivery estimates and set your default delivery address."
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ]
    ]
  }
}
